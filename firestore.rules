rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isCreatingDocForSelf() {
      return isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Documents collection
    match /documents/{documentId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isCreatingDocForSelf();
      allow update: if isDocOwner() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // Reminders collection
    match /reminders/{reminderId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isCreatingDocForSelf();
      allow update: if isDocOwner() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isDocOwner();
    }

    // Users collection
    match /users/{userId} {
      allow get, write: if isOwner(userId);
    }
  }
}
